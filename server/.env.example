# ScamGuard server configuration.
# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000

# Cline SDK provider settings. Use the provider and model IDs from
# https://docs.cline.bot/sdk/overview for the provider you have a key for.
CLINE_PROVIDER_ID=
CLINE_MODEL_ID=
CLINE_API_KEY=

# Offline demo mode: true returns deterministic stub verdicts and never calls the LLM.
USE_STUB=false

# Abuse protection for POST /api/analyze: at most RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS per client IP.
# Over the limit the server answers HTTP 429 with a Retry-After header. Request bodies over 10 kB get HTTP 413.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Testing only: with USE_STUB=true, wait this many milliseconds before answering (0 = no delay).
STUB_DELAY_MS=0

# Privacy: when false, the server logs only the verdict and message length, never the text.
LOG_TEXT=false
