{
  "manifest_version": 3,
  "name": "ScamGuard",
  "version": "0.1.0",
  "description": "Privacy-first shield that detects scam messages and malicious APK attachments on WhatsApp Web.",
  "action": {
    "default_title": "ScamGuard",
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://web.whatsapp.com/*", "http://localhost:5500/*"],
      "js": ["src/content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:5000/*"]
}
